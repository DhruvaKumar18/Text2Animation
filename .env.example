# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-in-production-with-something-secure
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL in production, defaults to sqlite if empty/not provided)
# DB_URL=postgres://user:password@localhost:5432/text2animation_db
# DB_NAME=text2animation_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# FFmpeg Configuration (Optional if ffmpeg is in path, otherwise specify full path)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Media and Static root directories (optional overrides)
# STATIC_ROOT=
# MEDIA_ROOT=

# LLM API Keys for Story Polishing (Fill these in to enable real API polishing)
